{
  "name": "pi-resume-remind",
  "version": "0.1.1",
  "description": "Pi CLI extension that reminds users how to resume the current session when quitting",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "pi-coding-agent",
    "resume",
    "remind",
    "session-reminder"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/buihongduc132/pi-resume-remind.git"
  },
  "bugs": {
    "url": "https://github.com/buihongduc132/pi-resume-remind/issues"
  },
  "homepage": "https://github.com/buihongduc132/pi-resume-remind#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src/index.ts",
    "src/resume.ts",
    "src/commands.ts",
    "README.md",
    "AGENTS.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:ci": "vitest run --coverage",
    "check": "npm run typecheck && npm run test:ci"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "@vitest/coverage-v8": "^3.2.4",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "author": "buihongduc132"
}
